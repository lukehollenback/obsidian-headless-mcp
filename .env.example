# Copy to .env (next to docker-compose.yml) and fill in.

# --- Required ---------------------------------------------------------------

# Any name you make up; enter the same value as the "OAuth Client ID" in Claude.
MCP_CLIENT_ID=my-obsidian

# Password you type on the approval page when connecting a client.
# Generate one with: openssl rand -base64 32
APPROVAL_PASSWORD=change-me

# Public HTTPS address of the server, without /mcp
MCP_BASE_URL=https://vault.example.com

# Cloudflare dashboard -> Networking -> Tunnels -> your tunnel -> Docker command (the token after --token)
CLOUDFLARE_TUNNEL_TOKEN=paste-token-here

# --- Optional ---------------------------------------------------------------

VAULT_DISPLAY_NAME=My Vault

# Read-only until you set this to false
VAULT_READ_ONLY=true

# Daily note location/format, if you use daily notes
# DAILY_NOTE_PATH_TEMPLATE=Daily/{YYYY}-{MM}-{DD}.md

# Never-expiring API key for clients without OAuth (e.g. Claude Code with --header)
# Generate with: openssl rand -base64 48
# MCP_STATIC_BEARER_TOKEN=

# Pin different versions of the downloaded tools (defaults are set in the image)
# OB_VERSION=0.0.14
# MCP_REF=474346f054982c0ce80f3b158336666351656586
